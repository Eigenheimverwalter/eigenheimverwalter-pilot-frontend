PORT=8080
APP_ORIGIN=http://localhost:8080
SESSION_SECRET=replace-with-at-least-32-random-characters
UPLOAD_MAX_BYTES=5242880
DATA_FILE=./data/runtime.json
EHV_APP_INTEGRATION_KEY=replace-with-a-separate-strong-app-integration-secret
# Der produktive Mail-Adapter verarbeitet emailOutbox; SMTP-Zugang vor Go-live hinterlegen.
MAIL_TRANSPORT=outbox
# Offizieller DWD-Warnabruf wird im Admin-Plus-Systemmenü manuell ausgelöst.
# Produktiv sollte der gleiche Adapter über den Server-Scheduler regelmäßig laufen.
WEATHER_DWD_ENABLED=true
